{
  "name": "@levi-putna/storyboard-core",
  "version": "0.3.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --external react --external react-dom --external @levi-putna/storyboard-schema --external @levi-putna/storyboard-transitions --external @levi-putna/storyboard-media",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@levi-putna/storyboard-schema": "0.3.0"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "tsup": "^8.4.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "description": "Frame context, Sequence, interpolate, spring, and composition primitives",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/levi-putna/first-take.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/levi-putna/first-take#readme",
  "bugs": {
    "url": "https://github.com/levi-putna/first-take/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}

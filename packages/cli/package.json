{
  "name": "first-take",
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "first-take": "./dist/cli.js"
  },
  "main": "./dist/cli.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "storyboard": "node ./dist/cli.js",
    "first-take": "node ./dist/cli.js"
  },
  "dependencies": {
    "@levi-putna/storyboard-preview": "0.3.0",
    "@levi-putna/storyboard-renderer": "0.3.0",
    "@levi-putna/storyboard-schema": "0.3.0",
    "commander": "^13.1.0",
    "consola": "^3.4.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "tsup": "^8.4.0"
  },
  "description": "CLI to create, validate, preview, and render First Take videos",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/levi-putna/first-take.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/levi-putna/first-take#readme",
  "bugs": {
    "url": "https://github.com/levi-putna/first-take/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "first-take",
    "storyboard",
    "video",
    "react",
    "ffmpeg",
    "explainer",
    "npx"
  ],
  "exports": {
    ".": {
      "import": "./dist/cli.js",
      "default": "./dist/cli.js"
    },
    "./package.json": "./package.json"
  }
}

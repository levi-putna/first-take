{
  "name": "@levi-putna/storyboard-preview",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "app"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --external react --external react-dom --external @levi-putna/storyboard-core --external @levi-putna/storyboard-schema --external @levi-putna/storyboard-media --external @levi-putna/storyboard-transitions --external vite",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@levi-putna/storyboard-core": "0.1.0",
    "@levi-putna/storyboard-media": "0.1.0",
    "@levi-putna/storyboard-schema": "0.1.0",
    "@levi-putna/storyboard-transitions": "0.1.0",
    "lucide-react": "^0.511.0",
    "vite": "^6.3.5"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "tsup": "^8.4.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "description": "Local Storyboard studio",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/levi-putna/storyboard.git",
    "directory": "packages/preview"
  },
  "homepage": "https://github.com/levi-putna/storyboard#readme",
  "bugs": {
    "url": "https://github.com/levi-putna/storyboard/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}

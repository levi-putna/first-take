{
  "name": "@storyboard/renderer",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts src/client.tsx --format esm --dts --clean --external react --external react-dom --external @storyboard/core --external @storyboard/schema --external @storyboard/media --external @storyboard/transitions",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@storyboard/core": "0.1.0",
    "@storyboard/media": "0.1.0",
    "@storyboard/schema": "0.1.0",
    "@storyboard/transitions": "0.1.0",
    "execa": "^9.5.2",
    "playwright": "^1.52.0",
    "sirv": "^3.0.1",
    "vite": "^6.3.5"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "tsup": "^8.4.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  }
}
